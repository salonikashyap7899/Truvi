{
  "appId": "com.truviventures.app",
  "appName": "Truvi",
  "webDir": "dist",
  "server": {
    "url": "https://truviventures.com",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0a0d14"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": false,
      "backgroundColor": "#0a0d14",
      "showSpinner": true,
      "spinnerColor": "#3B82F6",
      "androidSpinnerStyle": "large"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#0a0d14"
    }
  }
}
